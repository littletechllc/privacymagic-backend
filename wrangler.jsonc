{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "privacymagic-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ],
  "routes": [
    { "pattern": "reports.privacymagic.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "REPORT_TO": "reports@privacymagic.com",
    "REPORT_FROM": "noreply@reports.privacymagic.com"
  },
  // This binding can deliver only to the reports mailbox. A public form
  // cannot turn the Worker into an open mailer.
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "reports@privacymagic.com",
      "allowed_sender_addresses": ["noreply@reports.privacymagic.com"]
    }
  ],
  "ratelimits": [
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
